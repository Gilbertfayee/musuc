  $('#dlq').value=S.dlq;$('#theme').value=S.theme;
  $('#cid').onchange=e=>{S.cid=e.target.value.trim();saveS();home=null;searchRes=null};
  $('#dlq').onchange=e=>{S.dlq=e.target.value;saveS();home=null;searchRes=null};
  $('#free').onchange=e=>{S.free=e.target.checked;saveS();home=null;searchRes=null};
  $('#theme').onchange=e=>{S.theme=e.target.value;saveS()};
  $('#persist').onclick=async()=>{const ok=navigator.storage&&navigator.storage.persist?await navigator.storage.persist():false;toast(ok?'Stockage protégé':'Non accordé par le navigateur')};
 }
};
const TABS=[['home','♪','Accueil'],['search','⌕','Recherche'],['lib','▤','Bibliothèque'],['dl','⬇︎','Téléchargements'],['set','⚙︎','Réglages']];
function render(){
 const main=$('#main'),sc=main.scrollTop;
 const key=view.startsWith('pl:')?'pl':view;
 $('#tabs').innerHTML=TABS.map(([k,i,l])=>`<button class="${key===k||(key==='pl'&&k==='lib')?'on':''}" data-tab="${k}"><u>${i}</u>${l}</button>`).join('');
 if(document.activeElement&&document.activeElement.id==='q')return;
 V[key](main);window.scrollTo(0,0);
}
document.addEventListener('click',async e=>{
 const tb=e.target.closest('[data-tab]');if(tb){view=tb.dataset.tab;return render()}
 const a=e.target.closest('[data-act]');if(!a)return;
 const id=a.dataset.id,t=T[id],act=a.dataset.act;
 if(act==='play')playList(a.dataset.l,+a.dataset.i);
 else if(act==='jump')playAt(+a.dataset.i);
 else if(act==='fav'&&t)toggleFav(t);
 else if(act==='add'&&t)addToPl(t);
 else if(act==='dl'&&t){startDl(t);toast('Téléchargement ajouté')}
 else if(act==='pause')dlPause(id);else if(act==='resume')dlResume(id);else if(act==='cancel')dlCancel(id);
 else if(act==='del'){if(confirm('Supprimer ce titre de l\'appareil ?'))delTrack(id)}
 else if(act==='openpl'){view='pl:'+id;render()}
 else if(act==='back'){view='lib';render()}
 else if(act==='dlpl'){const p=playlists.find(x=>x.id===id);p.tracks.forEach(x=>startDl(T[x.id]||x));toast('Titres éligibles ajoutés aux téléchargements');render()}
 else if(act==='rmpl'){if(confirm('Supprimer cette playlist ?')){await run('playlists','readwrite',x=>x.objectStore('playlists').delete(id));playlists=playlists.filter(x=>x.id!==id);view='lib';render()}}
});
addEventListener('online',()=>{home=null;if(view==='home')render()});
addEventListener('offline',()=>toast('Mode hors ligne'));

(async()=>{
 try{await loadLocal()}catch{toast('Stockage local indisponible')}
 view=navigator.onLine?'home':'dl';render();
 if('serviceWorker' in navigator)navigator.serviceWorker.register('sw.js').catch(()=>{});
})();
