     <button class="ib" data-act="cancel" data-id="${d.t.id}">✕</button></div>`}).join(''):'')+
   '<h2>Disponibles hors ligne</h2>'+
   (downloaded.size?[...downloaded.values()].sort((a,b)=>b.dlAt-a.dlAt).map((t,i,arr)=>{lists.off=arr;
    return `<div class="row" data-act="play" data-l="off" data-i="${i}"><img src="${esc(cov(t))}" alt=""><div class="meta"><b>${esc(t.title)}</b><span>${esc(t.artist)} · ${mb(t.size||0)}</span></div><button class="ib" data-act="del" data-id="${t.id}">🗑</button></div>`}).join(''):'<div class="note">Rien pour l\'instant. Appuie sur ⬇︎ à côté d\'un titre, ou importe tes fichiers.</div>');
  if(navigator.storage&&navigator.storage.estimate)navigator.storage.estimate().then(e=>{const s=$('#stor');if(s)s.textContent='Stockage utilisé : '+mb(e.usage||0)+' sur '+mb(e.quota||0)+' disponibles'});
 },
 set(el){
